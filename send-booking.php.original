<?php
declare(strict_types=1);

/*
 * FMZ Glow booking form handler
 * Upload this file beside index.html on your cPanel hosting.
 */

// CHANGE THIS if the website has a real email address on its own domain.
// Use an address on your hosting domain for best mail deliverability.
$recipientEmail = 'fmz@fmzau.com.au';
$fromEmail = 'myfmz@myfmz.com';
$businessName = 'FMZ Glow';

function respond(string $title, string $message, int $statusCode = 200): void
{
    http_response_code($statusCode);
    $safeTitle = htmlspecialchars($title, ENT_QUOTES, 'UTF-8');
    $safeMessage = nl2br(htmlspecialchars($message, ENT_QUOTES, 'UTF-8'));
    echo '<!doctype html><html lang="en"><head><meta charset="utf-8">';
    echo '<meta name="viewport" content="width=device-width, initial-scale=1">';
    echo '<meta name="theme-color" content="#7a2e2e"><title>' . $safeTitle . ' | FMZ Glow</title>';
    echo '<style>
      *{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;
      padding:24px;background:#fbf7f3;color:#302525;font:16px/1.6 Arial,sans-serif}
      main{width:min(100%,560px);padding:36px;border-radius:18px;background:#fff;
      box-shadow:0 12px 40px rgba(50,25,25,.09);text-align:center}
      h1{color:#7a2e2e;margin:0 0 14px;font-size:28px}p{margin:0 0 24px}
      a{display:inline-block;padding:12px 22px;border-radius:30px;background:#7a2e2e;
      color:#fff;text-decoration:none;font-weight:bold}
    </style></head><body><main><h1>' . $safeTitle . '</h1><p>' . $safeMessage . '</p>';
    echo '<a href="index.html">Back to FMZ Glow</a></main></body></html>';
    exit;
}

if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    header('Allow: POST');
    respond('Invalid request', 'Please submit your booking using the form on the FMZ Glow website.', 405);
}

function postValue(string $key): string
{
    $value = $_POST[$key] ?? '';
    if (!is_string($value)) {
        return '';
    }
    return trim($value);
}

$name = postValue('name');
$phone = postValue('phone');
$pin = postValue('pin');
$service = postValue('service');
$date = postValue('date');
$time = postValue('time');
$message = postValue('msg');
$consent = postValue('consent');

$allowedServices = [
    'FMZ Glow Cleanse',
    'Nu Skin LumiSpa Glow Facial',
    'Nu Skin Radiance Ritual',
    'Glow 3-Visit Plan',
    'Not sure, help me choose'
];
$allowedTimes = ['', 'Morning', 'Afternoon', 'Evening'];

$errors = [];
if ($name === '' || mb_strlen($name) > 100) {
    $errors[] = 'Enter your name (maximum 100 characters).';
}
if (!preg_match('/^[0-9+\s()\-]{8,18}$/', $phone)) {
    $errors[] = 'Enter a valid WhatsApp number.';
}
if (!preg_match('/^[0-9]{6}$/', $pin)) {
    $errors[] = 'Enter a valid 6-digit pincode.';
}
if (!in_array($service, $allowedServices, true)) {
    $errors[] = 'Choose a valid service.';
}
if (!in_array($time, $allowedTimes, true)) {
    $errors[] = 'Choose a valid preferred time.';
}
if ($date !== '') {
    $dateObject = DateTime::createFromFormat('!Y-m-d', $date, new DateTimeZone('Asia/Kolkata'));
    $dateErrors = DateTime::getLastErrors();
    if (!$dateObject || ($dateErrors !== false && ($dateErrors['warning_count'] > 0 || $dateErrors['error_count'] > 0))
        || $dateObject->format('Y-m-d') !== $date
        || $dateObject < new DateTime('today', new DateTimeZone('Asia/Kolkata'))) {
        $errors[] = 'Choose a valid date today or later.';
    }
}
if (mb_strlen($message) > 2000) {
    $errors[] = 'Keep your skin concern message under 2,000 characters.';
}
if ($consent !== 'yes') {
    $errors[] = 'Please agree to be contacted about this request.';
}

if ($errors) {
    respond('Please check your details', implode("\n", $errors), 422);
}

// Remove line breaks from fields that may appear in mail headers or subject.
$name = preg_replace('/[\r\n]+/', ' ', $name);
$phone = preg_replace('/[\r\n]+/', ' ', $phone);

$subject = 'New FMZ Glow booking request';
$body = "A new booking request was submitted on the FMZ Glow website.\n\n"
      . "Name: {$name}\n"
      . "WhatsApp number: {$phone}\n"
      . "Pincode: {$pin}\n"
      . "Service: {$service}\n"
      . "Preferred date: " . ($date !== '' ? $date : 'No preference') . "\n"
      . "Preferred time: " . ($time !== '' ? $time : 'No preference') . "\n"
      . "Skin concern: " . ($message !== '' ? $message : 'Not provided') . "\n"
      . "Consent: Yes\n";

$host = preg_replace('/[^a-zA-Z0-9.-]/', '', $_SERVER['HTTP_HOST'] ?? 'yourdomain.com');
$headers = [
    'From: ' . $businessName . ' <' . $fromEmail . '>',
    'Reply-To: ' . $fromEmail,
    'MIME-Version: 1.0',
    'Content-Type: text/plain; charset=UTF-8',
    'X-Mailer: PHP/' . phpversion()
];

$mailSent = mail(
    $recipientEmail,
    '=?UTF-8?B?' . base64_encode($subject) . '?=',
    $body,
    implode("\r\n", $headers)
);

if (!$mailSent) {
    error_log('FMZ Glow booking email could not be handed to the mail server. Host: ' . $host);
    respond(
        'We could not send your request',
        'The booking form could not send your email right now. Please contact FMZ Glow directly on WhatsApp or try again later.',
        500
    );
}

respond(
    'Thank you for your booking request!',
    'Your request has been sent to the FMZ Glow team. This is not an appointment confirmation; the team will contact you to confirm the specialist, price and visit details.'
);
