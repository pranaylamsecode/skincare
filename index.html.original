<div class="mobile-cta"><a class="btn" href="#book">Book your glow</a></div>


<script>
document.getElementById('yr').textContent = new Date().getFullYear();

(function(){
  var b = document.getElementById('menuBtn'),
      m = document.getElementById('mobileMenu');

  function set(o) {
    m.classList.toggle('open', o);
    b.setAttribute('aria-expanded', o);
    b.setAttribute('aria-label', o ? 'Close menu' : 'Open menu');
  }

  b.addEventListener('click', function(){
    set(!m.classList.contains('open'));
  });

  m.querySelectorAll('a').forEach(function(a){
    a.addEventListener('click', function(){
      set(false);
    });
  });

  window.addEventListener('resize', function(){
    if(innerWidth > 820) set(false);
  });
})();

(function(){
  var c = document.querySelector('.mobile-cta'),
      s = document.getElementById('book');

  if(!c || !('IntersectionObserver' in window)) return;

  new IntersectionObserver(function(e){
    c.classList.toggle('hide', e[0].isIntersecting);
  }, {threshold: .15}).observe(s);
})();

document.querySelectorAll('.pkg').forEach(function(a){
  a.addEventListener('click', function(){
    var sel = document.getElementById('service'),
        v = a.getAttribute('data-pkg');

    Array.from(sel.options).forEach(function(o){
      if(o.text === v) sel.value = o.value;
    });
  });
});



(function(){
  var c=document.querySelector('.mobile-cta'),s=document.getElementById('book');
  if(!c||!('IntersectionObserver' in window))return;
  new IntersectionObserver(function(e){c.classList.toggle('hide',e[0].isIntersecting)},{threshold:.15}).observe(s);
})();



// Before/after sliders
document.querySelectorAll('.ba').forEach(function(ba){
  var r = ba.querySelector('input[type=range]');
  if(!r) return;
  r.addEventListener('input', function(){
    ba.style.setProperty('--pos', r.value + '%');
  });
});


// Specialist city filter + prefill booking note
document.querySelectorAll('.spec-filter button').forEach(function(b){
  b.addEventListener('click', function(){
    document.querySelectorAll('.spec-filter button').forEach(function(x){x.classList.remove('active')});
    b.classList.add('active');
    var f = b.getAttribute('data-filter');
    document.querySelectorAll('.spec').forEach(function(c){
      c.style.display = (f === 'all' || c.getAttribute('data-city') === f) ? 'flex' : 'none';
    });
  });
});
document.querySelectorAll('.spec-book').forEach(function(a){
  a.addEventListener('click', function(){
    var m = document.getElementById('msg');
    if(m) m.value = 'Preferred specialist: ' + a.getAttribute('data-specialist');
  });
});

// Set minimum booking date to today
var d = new Date();
document.getElementById('date').min =
    new Date(d.getTime() - d.getTimezoneOffset() * 6e4)
    .toISOString().slice(0, 10);

</script>

<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/vce701823e78c4301a35b7e07294d87301792088814092" integrity="sha512-UKNk8GbxkABxKcXYuLkO16EleLGUkcvJWtpSNmExE0Too3ZaFAxTscNWEc1OdAv5/BikHawapSCaiD2XCmp+Bw==" data-cf-beacon='{"version":"2024.11.0","token":"c8797d1785c746c1b0476b1d8ed49cd5","r":1,"spa":2}' crossorigin="anonymous"></script>
</body>
</html>
